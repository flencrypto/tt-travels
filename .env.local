# TT Travels Environment Variables
# Replace the placeholder values below with your actual API keys.
# WARNING: Do not commit real API keys to version control.

# Required: Clerk Authentication
# Get your key from: https://dashboard.clerk.com/~/api-keys
# Replace with your actual Clerk Publishable Key (starts with pk_test_ or pk_live_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_c2VsZWN0ZWQtcGFuZGEtNS5jbGVyay5hY2NvdW50cy5kZXYk

# Optional: Amadeus API Credentials for flight and hotel search
# Get your credentials from: https://developers.amadeus.com/my-apps
# NOTE: You can also configure these in the Settings page of the app (recommended)
# Settings page credentials take precedence over environment variables
# See AMADEUS_SETUP_GUIDE.md for detailed setup instructions
VITE_AMADEUS_API_KEY=
VITE_AMADEUS_API_SECRET=

# NOTE: AI features (trip planning, itineraries, recommendations) are powered by 
# Spark's built-in AI and don't require any API keys!
